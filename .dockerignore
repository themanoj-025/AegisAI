# ── AegisAI .dockerignore ─────────────────────────────────────────────
# Keep the build context small and keep secrets out of image layers.

# VCS metadata
.git
.gitignore
.gitattributes

# Python caches / artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment & secrets — NEVER ship these into an image
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Workspace (cloned repos — runtime only, never part of the build)
workspace/

# IDE / editor config
.vscode/
.idea/
*.swp
*.swo

# CI / agent config
.github/
.gemini/
.cursorrules
AGENTS.md
PROJECT_ANALYSIS.md

# Logs
*.log
logs/
