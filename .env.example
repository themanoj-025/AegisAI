# AegisAI - Environment Template
# Copy to .env and fill in real values. NEVER commit .env.

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@localhost:5432/aegisai
WORKSPACE_DIR=./workspace

# API authentication (leave blank for open access)
AEGIS_API_KEY=

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Webhook retry queue (events are retried with backoff before dead-lettering)
WEBHOOK_RETRY_QUEUE=webhook-retry
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF=60,300,900,1800

# Review job execution (RQ retries on transient worker failures)
REVIEW_JOB_TIMEOUT=1800
REVIEW_JOB_MAX_RETRIES=3
REVIEW_JOB_BACKOFF=60,300,900
